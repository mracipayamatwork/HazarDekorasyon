@page
@model KatalogModel
@{
    ViewData["Title"] = "Duvar Kağıdı Kataloğu | Hazar Dekorasyon";
    ViewData["Description"] = "Hazar Dekorasyon duvar kağıdı kataloğu: damask, botanik, geometrik, mermer, keten doku, çocuk odası ve panoramik duvar kağıtları. Renge, mekâna ve stile göre filtreleyin.";
    ViewData["BodyClass"] = "page-katalog";
    var Site = Model.Site;
}
@section Styles {
  <link rel="stylesheet" href="~/assets/css/katalog.css" asp-append-version="true" />
}

<!-- Sayfa başlığı -->
<section class="khero">
  <div class="khero__pattern" data-khero-pattern aria-hidden="true"></div>
  <div class="container khero__inner">
    <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana Sayfa</a><span>/</span><b>Katalog</b></nav>
    <h1 class="khero__title">Duvar Kağıdı <em>Kataloğu</em></h1>
    <p class="lead">Klasik damasklardan doğal keten dokulara, çocuk odası desenlerinden panoramik duvar resimlerine… Renge, mekâna ve stile göre filtreleyin; beğendiklerinizi favorilere ekleyip tek tıkla bize gönderin.</p>
    <div class="kcats" data-kcats></div>
  </div>
</section>

<!-- Araç çubuğu -->
<div class="ktool" data-ktool>
  <div class="container ktool__inner">
    <button class="ktool__filter-btn" data-open-filters>
      <svg viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4"/></svg>Filtrele<span data-filter-count></span>
    </button>
    <label class="ksearch">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="Desen, koleksiyon veya kod ara (ör. damask, HZ-1021)" data-search />
    </label>
    <div class="ktool__right">
      <span class="kcount"><b data-count-num>0</b> desen</span>
      <label class="kselect">
        <span>Sırala</span>
        <select data-sort>
          <option value="onerilen">Önerilen</option>
          <option value="yeni">Yeni gelenler</option>
          <option value="az">İsim (A–Z)</option>
          <option value="za">İsim (Z–A)</option>
        </select>
      </label>
      <div class="kview" role="group" aria-label="Görünüm">
        <button class="is-active" data-cols="4" aria-label="Sık görünüm"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></button>
        <button data-cols="3" aria-label="Geniş görünüm"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="8"/><rect x="3" y="14" width="18" height="7"/></svg></button>
      </div>
    </div>
  </div>
</div>

<section class="kbody">
  <div class="container kbody__grid">
    <!-- Filtreler -->
    <aside class="kfilters" data-filters>
      <div class="kfilters__head">
        <h3>Filtreler</h3>
        <button class="pmodal__close" style="position:static;box-shadow:none" data-close-filters aria-label="Kapat"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </div>
      <div class="kfilters__scroll">
        <div class="fgroup">
          <h4>Renk Tonu</h4>
          <div class="ftones" data-f-tones></div>
        </div>
        <div class="fgroup">
          <h4>Mekân</h4>
          <div class="flist" data-f-rooms></div>
        </div>
        <div class="fgroup">
          <h4>Materyal</h4>
          <div class="flist" data-f-materials></div>
        </div>
        <div class="fgroup">
          <h4>Öne Çıkanlar</h4>
          <div class="flist" data-f-flags></div>
        </div>
      </div>
      <div class="kfilters__foot">
        <button class="btn btn--ghost btn--sm" data-clear>Temizle</button>
        <button class="btn btn--dark btn--sm" data-close-filters>Sonuçları Gör (<span data-count-num>0</span>)</button>
      </div>
    </aside>
    <div class="kfilters__backdrop" data-close-filters></div>

    <!-- Ürünler -->
    <div class="kresults">
      <div class="kactive" data-active></div>
      <div class="kgrid" data-grid></div>
      <div class="kempty" data-empty hidden>
        <svg viewBox="0 0 64 64"><rect x="10" y="8" width="44" height="48" rx="4"/><path d="M10 20h44M22 32h20M22 40h12"/></svg>
        <h3>Bu kriterlere uygun desen bulunamadı</h3>
        <p>Filtreleri azaltmayı deneyin ya da aradığınız deseni bize sorun; numune kataloglarımızda yüzlerce seçenek daha var.</p>
        <button class="btn btn--dark" data-clear>Filtreleri Temizle</button>
      </div>
    </div>
  </div>
</section>

<!-- Alt çağrı -->
<section class="kcta">
  <div class="container kcta__inner">
    <div class="kcta__swatches" data-kcta-swatches aria-hidden="true"></div>
    <div class="kcta__text">
      <p class="eyebrow light">Numune Kataloğu</p>
      <h2 class="h2 light">Desenleri <em>elinizle</em> dokunarak seçin.</h2>
      <p>Ücretsiz keşif randevusunda numune kataloglarımızı da yanımızda getiriyoruz. Dokuyu, rengi ve ışığı kendi mekânınızda görün.</p>
      <div class="kcta__btns">
        <a href="@Site.WhatsAppUrl("Merhaba, numune kataloğu ile ücretsiz keşif randevusu almak istiyorum.")" target="_blank" rel="noopener" class="btn btn--light btn--lg">Randevu Al</a>
        <a href="tel:@Site.Phone" class="btn btn--ghost btn--lg kcta__ghost">@Site.PhoneDisplay</a>
      </div>
    </div>
  </div>
</section>
  

@section Scripts {
  <script src="~/assets/js/katalog.js" asp-append-version="true"></script>
}
