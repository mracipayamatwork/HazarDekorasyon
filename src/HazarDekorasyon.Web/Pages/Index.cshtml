@page
@model IndexModel
@{
ViewData["Title"] = "Hazar Dekorasyon | Duvar Kağıdı · Gergi Tavan · Anahtar Teslim";
ViewData["BodyClass"] = "";
var Site = Model.Site;
}
<!-- HERO -->
<section class="hero">
  <div class="hero__bg-word" aria-hidden="true">Hazar</div>
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow"><span class="line"></span>Duvar Kağıdı · Gergi Tavan · Anahtar Teslim</p>
      <h1 class="hero__title">
        <span class="split"><span>Duvarlarınız</span></span>
        <span class="split"><span>hikâyenizi</span></span>
        <span class="split"><span><em>anlatsın.</em></span></span>
      </h1>
      <p class="hero__lead">Yüzlerce desen arasından seçin; ölçüden uygulamaya her adımı biz üstlenelim. Hazar Dekorasyon ile evinize ilk günkü heyecanı yeniden getirin.</p>
      <div class="hero__ctas">
        <a href="/katalog" class="btn btn--primary btn--lg magnetic">Kataloğu Keşfet <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a href="#iletisim" class="btn btn--ghost btn--lg">Ücretsiz Keşif İste</a>
      </div>
      <ul class="hero__perks">
        <li><span class="perk-ico"><svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg></span>Ücretsiz keşif<br />& ölçü</li>
        <li><span class="perk-ico"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/></svg></span>Usta uygulama<br />ekibi</li>
        <li><span class="perk-ico"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span>Temiz & garantili<br />teslim</li>
      </ul>
    </div>

    <div class="hero__visual">
      <div class="arch" data-hero-slider>
        <figure class="arch__slide is-active" style="--img:url('https://images.unsplash.com/photo-1785119774248-3e9e394e675a?auto=format&fit=crop&w=1200&q=80')" data-label="Klasik Salon"></figure>
        <figure class="arch__slide" style="--img:url('https://images.unsplash.com/photo-1602364557801-8908351b0c7e?auto=format&fit=crop&w=1200&q=80')" data-label="Botanik Köşe"></figure>
        <figure class="arch__slide" style="--img:url('https://images.unsplash.com/photo-1775595224318-83ad712fe52e?auto=format&fit=crop&w=1200&q=80')" data-label="Çiçekli Yatak Odası"></figure>
        <figure class="arch__slide" style="--img:url('https://images.unsplash.com/photo-1640109478916-f445f8f19b11?auto=format&fit=crop&w=1200&q=80')" data-label="Yeşil Huzur"></figure>
      </div>
      <div class="hero__badge" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><path id="circ" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0" /></defs>
          <text><textPath href="#circ">ÜCRETSİZ KEŞİF • HAZAR DEKORASYON • </textPath></text>
        </svg>
        <span>✦</span>
      </div>
      <button class="hero__card" data-hero-feature>
        <span class="hero__card-swatch" data-hero-swatch></span>
        <span class="hero__card-text"><small>Sezonun favorisi</small><b data-hero-feature-name>Ginkgo</b><i>İncele →</i></span>
      </button>
      <div class="hero__dots" data-hero-dots></div>
      <div class="hero__caption"><span data-hero-caption>Klasik Salon</span></div>
    </div>
  </div>
  <a href="#renkler" class="scroll-cue" aria-label="Aşağı kaydır"><span></span></a>
</section>

<!-- Kayan şerit -->
<div class="ribbon">
  <div class="ribbon__track">
    <span>Duvar Kağıdı</span><i>✦</i><span>Gergi Tavan</span><i>✦</i><span>Anahtar Teslim</span><i>✦</i><span>Boya & Badana</span><i>✦</i><span>Dekoratif Aydınlatma</span><i>✦</i><span>Kartonpiyer</span><i>✦</i>
    <span>Duvar Kağıdı</span><i>✦</i><span>Gergi Tavan</span><i>✦</i><span>Anahtar Teslim</span><i>✦</i><span>Boya & Badana</span><i>✦</i><span>Dekoratif Aydınlatma</span><i>✦</i><span>Kartonpiyer</span><i>✦</i>
  </div>
</div>

<!-- Renkler -->
<section class="section tones" id="renkler">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow">Renk Paleti</p>
      <h2 class="h2">Renkleri <em>keşfet</em></h2>
      <p class="lead">Mekânınızın ruhuna uygun tonu seçin, size özel desenleri anında listeleyelim.</p>
    </div>
    <div class="tones__list reveal" data-tones></div>
  </div>
</section>

<!-- Neden Hazar -->
<section class="features">
  <div class="container features__grid">
    <div class="feature reveal">
      <span class="feature__ico"><svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/></svg></span>
      <h3>Ücretsiz Keşif</h3><p>Adresinize gelip ölçü alıyor, mekâna uygun önerilerde bulunuyoruz.</p>
    </div>
    <div class="feature reveal" style="--d:.08s">
      <span class="feature__ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
      <h3>Geniş Katalog</h3><p>Klasikten moderne, çocuk odasından ofise yüzlerce desen.</p>
    </div>
    <div class="feature reveal" style="--d:.16s">
      <span class="feature__ico"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/></svg></span>
      <h3>Usta İşçilik</h3><p>Desen eşleştirmesi kusursuz, birleşim yerleri görünmez uygulama.</p>
    </div>
    <div class="feature reveal" style="--d:.24s">
      <span class="feature__ico"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>
      <h3>Temiz Teslim</h3><p>Uygulama sonrası alanı temizleyip, kullanıma hazır teslim ederiz.</p>
    </div>
    <div class="feature reveal" style="--d:.32s">
      <span class="feature__ico"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span>
      <h3>İşçilik Garantisi</h3><p>Yaptığımız her işin arkasındayız; içiniz rahat olsun.</p>
    </div>
  </div>
</section>

<!-- Hizmetler -->
<section class="section services" id="hizmetler">
  <div class="container">
    <div class="section-head split-head reveal">
      <div>
        <p class="eyebrow">Hizmetlerimiz</p>
        <h2 class="h2">Tasarım. Kalite.<br /><em>Anahtar teslim.</em></h2>
      </div>
      <p class="lead">Tek bir duvardan komple ev yenilemeye kadar; seçimden uygulamaya tüm süreci tek elden yönetiyoruz.</p>
    </div>
    <div class="services__grid">
      <article class="service reveal">
        <div class="service__img" style="--img:url('https://images.unsplash.com/photo-1773499129465-4eda9cfd1147?auto=format&fit=crop&w=1000&q=80')"></div>
        <div class="service__body">
          <span class="service__no">01</span>
          <h3>Duvar Kağıdı</h3>
          <p>Damask, botanik, geometrik, mermer ve panoramik duvar resimleri. Ölçünüze özel, desen eşleşmeli uygulama.</p>
          <a href="/katalog" class="link-arrow">Kataloğu incele <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </article>
      <article class="service reveal" style="--d:.1s">
        <div class="service__img" style="--img:url('https://images.unsplash.com/photo-1784482267781-8f09c82a67f4?auto=format&fit=crop&w=1000&q=80')"></div>
        <div class="service__body">
          <span class="service__no">02</span>
          <h3>Gergi Tavan</h3>
          <p>Mat, saten, parlak ve ışıklı gergi tavan sistemleri. Gizli LED, yıldız tavan ve özel baskılı tavan çözümleri.</p>
          <a href="/fiyat-hesapla" class="link-arrow">Fiyat hesapla <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </article>
      <article class="service reveal" style="--d:.2s">
        <div class="service__img" style="--img:url('https://images.unsplash.com/photo-1600210491892-03d54c0aaf87?auto=format&fit=crop&w=1000&q=80')"></div>
        <div class="service__body">
          <span class="service__no">03</span>
          <h3>Anahtar Teslim İş</h3>
          <p>Boya, alçı, kartonpiyer, aydınlatma ve duvar kaplamaları dahil; projelendirmeden teslime komple yenileme.</p>
          <a href="#iletisim" class="link-arrow">Keşif planla <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Odanda Gör -->
<section class="section visualizer" id="odanda-gor">
  <div class="container visualizer__grid">
    <div class="visualizer__intro reveal">
      <p class="eyebrow">Odanda Gör</p>
      <h2 class="h2">Karar vermeden önce<br /><em>duvarında gör.</em></h2>
      <p class="lead">Bir desen seçin ve çizgiyi sürükleyerek odanın <b>öncesi</b> ile <b>sonrasını</b> karşılaştırın. Beğendiğiniz deseni tek tıkla inceleyin.</p>
      <div class="visualizer__picker" data-vis-picker></div>
      <div class="visualizer__meta">
        <div>
          <small data-vis-collection>Koleksiyon</small>
          <b data-vis-name>Desen</b>
        </div>
        <button class="btn btn--dark btn--sm" data-vis-open>Deseni İncele</button>
      </div>
    </div>
    <div class="visualizer__stage reveal" style="--d:.1s">
      <div class="room" data-room data-compare></div>
    </div>
  </div>
</section>

<!-- Koleksiyonlar -->
<section class="section collections">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow">Koleksiyonlar</p>
      <h2 class="h2">Kişiliğinizi yansıtan <em>duvar sanatı</em></h2>
    </div>
    <div class="collections__grid">
      @{ var ci = 0; }
      @foreach (var c in Model.HomeCategories)
      {
        var hasCover = !string.IsNullOrWhiteSpace(c.CoverImageUrl);
        var cls = "coll reveal" + (ci == 0 ? " coll--tall" : "") + (hasCover ? "" : " coll--pattern");
        var style = $"--d:{ci * 0.08:0.00}s".Replace(',', '.') + (hasCover ? $";--img:url('{c.CoverImageUrl}')" : "");
        <a href="/katalog?kategori=@c.Slug" class="@cls" style="@style" data-coll-pattern="@(hasCover ? null : Model.SampleKey(c))">
          <span class="coll__label"><small>@c.Tagline</small>@c.Name</span>
        </a>
        ci++;
      }
    </div>
  </div>
</section>

<!-- Çok satanlar -->
<section class="section bestsellers">
  <div class="container">
    <div class="section-head split-head reveal">
      <div>
        <p class="eyebrow">En Çok Tercih Edilenler</p>
        <h2 class="h2">Bu sezonun <em>favorileri</em></h2>
      </div>
      <div class="carousel-nav">
        <button class="round-btn" data-car-prev aria-label="Önceki"><svg viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <button class="round-btn" data-car-next aria-label="Sonraki"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        <a href="/katalog" class="btn btn--ghost btn--sm">Tümünü Gör</a>
      </div>
    </div>
    <div class="carousel" data-carousel></div>
  </div>
</section>

<!-- Fiyat hesaplama -->
<section class="section price-teaser">
  <div class="container price-teaser__grid">
    <div class="reveal">
      <p class="eyebrow">Fiyat Hesaplama</p>
      <h2 class="h2">Bütçenizi <em>bir dakikada</em> öğrenin.</h2>
      <p class="lead">Odanızın ölçülerini girin, hizmeti ve seçenekleri belirleyin; tahmini fiyatı anında görün. Beğenirseniz tek tıkla WhatsApp'tan bize gönderin.</p>
      <a href="/fiyat-hesapla" class="btn btn--primary btn--lg">Fiyat Hesapla <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <div class="price-teaser__cards reveal" style="--d:.1s">
      @foreach (var s in Model.PriceTeaser)
      {
        <a href="/fiyat-hesapla" class="pt-card">
          <small>@s.Name</small>
          <b>@s.FromPrice.ToString("N0") ₺<i>@s.UnitLabel</i></b>
          <span>başlayan fiyatlarla</span>
        </a>
      }
    </div>
  </div>
</section>

<!-- Süreç -->
<section class="section process" id="surec">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow light">Nasıl Çalışıyoruz?</p>
      <h2 class="h2 light">Dört adımda <em>yeni bir mekân</em></h2>
    </div>
    <ol class="process__list">
      <li class="step reveal"><span class="step__no">01</span><h3>Keşif & Ölçü</h3><p>Randevu gününde adresinize geliyor, ölçü alıp ihtiyacınızı dinliyoruz.</p></li>
      <li class="step reveal" style="--d:.1s"><span class="step__no">02</span><h3>Desen Seçimi</h3><p>Katalog ve numunelerle mekânınıza en uygun deseni birlikte seçiyoruz.</p></li>
      <li class="step reveal" style="--d:.2s"><span class="step__no">03</span><h3>Net Teklif</h3><p>Malzeme ve işçilik dahil, sürprizsiz ve şeffaf fiyat sunuyoruz.</p></li>
      <li class="step reveal" style="--d:.3s"><span class="step__no">04</span><h3>Uygulama & Teslim</h3><p>Usta ekibimiz uygulamayı yapar, alanı temizleyip teslim eder.</p></li>
    </ol>
  </div>
</section>

<!-- Projeler -->
<section class="section projects" id="projeler">
  <div class="container">
    <div class="section-head split-head reveal">
      <div>
        <p class="eyebrow">İlham Galerisi</p>
        <h2 class="h2">Duvarlarda <em>yeniden doğan</em> mekânlar</h2>
      </div>
      <div class="chips" data-gallery-filter>
        <button class="chip is-active" data-f="all">Tümü</button>
        <button class="chip" data-f="duvar">Duvar Kağıdı</button>
        <button class="chip" data-f="tavan">Gergi Tavan</button>
        <button class="chip" data-f="anahtar">Anahtar Teslim</button>
      </div>
    </div>
    <div class="gallery" data-gallery></div>
  </div>
</section>

<!-- Rakamlar -->
<section class="stats">
  <div class="container stats__grid">
    <div class="stat reveal"><b><span data-count="500">0</span>+</b><span>Tamamlanan proje</span></div>
    <div class="stat reveal" style="--d:.1s"><b><span data-count="10">0</span>+</b><span>Yıllık tecrübe</span></div>
    <div class="stat reveal" style="--d:.2s"><b><span data-count="2900">0</span>+</b><span>Instagram takipçisi</span></div>
    <div class="stat reveal" style="--d:.3s"><b>%<span data-count="100">0</span></b><span>Müşteri memnuniyeti</span></div>
  </div>
</section>

<!-- Yorumlar -->
<section class="section testimonials">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow">Müşteri Yorumları</p>
      <h2 class="h2">Onlar <em>anlatsın</em></h2>
    </div>
    <div class="tslider reveal" data-tslider>
      <div class="tslider__track">
        <blockquote class="tcard is-active">
          <div class="tcard__stars">★★★★★</div>
          <p>“Salonumuza damask duvar kağıdı uygulattık. Desenler o kadar düzgün eşleşti ki birleşim yerlerini bulamıyoruz. Ekip çok temiz ve titiz çalıştı.”</p>
          <footer><span class="avatar">AK</span><div><b>Ayşe K.</b><small>Salon · Duvar Kağıdı</small></div></footer>
        </blockquote>
        <blockquote class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p>“Gergi tavan ve gizli LED uygulaması yaptırdık, evin havası tamamen değişti. Söz verilen günde başlayıp söz verilen günde bitirdiler.”</p>
          <footer><span class="avatar">MY</span><div><b>Mehmet Y.</b><small>Oturma Odası · Gergi Tavan</small></div></footer>
        </blockquote>
        <blockquote class="tcard">
          <div class="tcard__stars">★★★★★</div>
          <p>“Kızımızın odası için yıldızlı duvar kağıdı seçtik. Hem seçim sürecinde hem uygulamada çok yardımcı oldular. Kesinlikle tavsiye ederim.”</p>
          <footer><span class="avatar">ZD</span><div><b>Zeynep D.</b><small>Çocuk Odası · Duvar Kağıdı</small></div></footer>
        </blockquote>
      </div>
      <div class="tslider__dots" data-tdots></div>
    </div>
  </div>
</section>

<!-- Instagram -->
<section class="section insta">
  <div class="container">
    <div class="insta__grid">
      <div class="insta__intro reveal">
        <p class="eyebrow">Bizi Takip Edin</p>
        <h2 class="h2">@@@Site.Instagram</h2>
        <p class="lead">En yeni uygulamalarımız, öncesi–sonrası videoları ve kampanyalar Instagram hesabımızda.</p>
        <a href="@Site.InstagramUrl" target="_blank" rel="noopener" class="btn btn--primary">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
          Instagram'da Takip Et
        </a>
      </div>
      <div class="insta__tiles" data-insta></div>
    </div>
  </div>
</section>

<!-- İletişim -->
<section class="section contact" id="iletisim">
  <div class="container contact__grid">
    <div class="contact__info reveal">
      <p class="eyebrow">İletişim</p>
      <h2 class="h2">Hayalinizdeki mekâna<br /><em>ilk adımı atın.</em></h2>
      <p class="lead">Formu doldurun, talebiniz WhatsApp üzerinden doğrudan bize ulaşsın. Ya da hemen arayın; ücretsiz keşif randevunuzu oluşturalım.</p>
      <ul class="contact__list">
        <li>
          <span class="contact__ico"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></span>
          <div><small>Telefon</small><a href="tel:@Site.Phone">@Site.PhoneDisplay</a></div>
        </li>
        <li>
          <span class="contact__ico"><svg viewBox="0 0 24 24"><path d="M3 21l1.6-4.6A8.5 8.5 0 1 1 8 19.6z"/><path d="M9 9.5c.5 2 2.5 4 4.5 4.5l1.2-1.2 1.8.8v1.6c-3.5.5-8-4-7.5-7.5h1.6l.8 1.8z"/></svg></span>
          <div><small>WhatsApp</small><a href="@Site.WhatsAppUrl()" target="_blank" rel="noopener">Mesaj gönderin</a></div>
        </li>
        <li>
          <span class="contact__ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg></span>
          <div><small>Instagram</small><a href="@Site.InstagramUrl" target="_blank" rel="noopener">@@@Site.Instagram</a></div>
        </li>
        @if (!string.IsNullOrWhiteSpace(Site.Address))
        {
          <li>
            <span class="contact__ico"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
            <div><small>Adres</small><span>@Site.Address</span></div>
          </li>
        }
        <li>
          <span class="contact__ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <div><small>Çalışma Saatleri</small><span>@Site.WorkingHours</span></div>
        </li>
      </ul>
    </div>
    <form class="contact__form reveal" style="--d:.1s" data-contact-form novalidate>
      <h3>Ücretsiz keşif talebi</h3>
      <div class="field-row">
        <label class="field"><input name="ad" required placeholder=" " /><span>Adınız Soyadınız</span></label>
        <label class="field"><input name="tel" type="tel" required placeholder=" " /><span>Telefon</span></label>
      </div>
      <div class="field-group">
        <span class="field-group__label">İlgilendiğiniz hizmet</span>
        <div class="chips chips--form">
          <label class="chip-check"><input type="checkbox" name="hizmet" value="Duvar Kağıdı" checked /><span>Duvar Kağıdı</span></label>
          <label class="chip-check"><input type="checkbox" name="hizmet" value="Gergi Tavan" /><span>Gergi Tavan</span></label>
          <label class="chip-check"><input type="checkbox" name="hizmet" value="Anahtar Teslim" /><span>Anahtar Teslim</span></label>
        </div>
      </div>
      <label class="field"><input name="ilce" placeholder=" " /><span>İl / İlçe</span></label>
      <label class="field"><textarea name="mesaj" rows="3" placeholder=" "></textarea><span>Mesajınız (oda, ölçü, beğendiğiniz desen…)</span></label>
      <button class="btn btn--primary btn--lg btn--block" type="submit">
        <svg viewBox="0 0 24 24"><path d="M3 21l1.6-4.6A8.5 8.5 0 1 1 8 19.6z"/></svg>
        WhatsApp ile Gönder
      </button>
      <p class="form-note">Gönder'e bastığınızda WhatsApp açılır ve mesajınız hazır olarak gelir.</p>
    </form>
  </div>
</section>

@section Scripts {
  <script>window.HAZAR_HOME = @Html.Raw(Model.HomeJson);</script>
  <script src="~/assets/js/home.js" asp-append-version="true"></script>
}
